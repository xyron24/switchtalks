# Non-secret settings only. Never put tokens or API keys in this file or in .env.
# The Gemini key lives in OpenCode's credential store, the Discord bot token in
# Switch Console, and GitHub auth in the macOS keychain (via `gh auth login`).

# Where demo/reset.sh builds the sandbox the agents work in (outside this repo).
DEMO_HOME=~/switch-demo

# Optional: git URL of your cart-service-demo repo. When set, the fixer agent
# can push its fix branch and open a pull request there.
DEMO_REMOTE=
